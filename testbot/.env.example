# Copy to testbot/.env for local webhook diagnostics.
# The FastAPI backend still reads backend/.env, so keep shared values in sync.

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public ngrok base URL for the local backend, without a trailing slash.
# Example: https://your-ngrok-domain.ngrok-free.app
BACKEND_PUBLIC_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional explicit expected URL. If set, it wins over BACKEND_PUBLIC_URL + path.
TELEGRAM_WEBHOOK_URL=
